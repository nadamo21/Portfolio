# Public site URL, used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://nada-mohamed-data.vercel.app

# ── WP Direct (server-side only — never prefix these with NEXT_PUBLIC_) ──
# While WPDIRECT_API_URL or WPDIRECT_API_KEY is empty, the contact form hands the
# message to WhatsApp (wa.me) instead, so the site works without credentials.
# Request body mapping lives in buildPayload() in src/lib/wpdirect.ts.

# Full URL of the WP Direct "send message" endpoint.
WPDIRECT_API_URL=
# API key / token issued by WP Direct.
WPDIRECT_API_KEY=
# Header that carries the key, and the scheme prefix ("" to send the raw key).
WPDIRECT_AUTH_HEADER=Authorization
WPDIRECT_AUTH_SCHEME=Bearer
# Optional instance / device / account id, if WP Direct requires one.
WPDIRECT_INSTANCE_ID=
# Number that receives new enquiries (international format, digits only).
WPDIRECT_RECIPIENT=201028585760
# Request timeout in milliseconds.
WPDIRECT_TIMEOUT_MS=8000
